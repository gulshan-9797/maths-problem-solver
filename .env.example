# ==============================================================================
# Mathematical Problem Solver: Environment Configuration
# ==============================================================================

# Cohere API Key (Get a free key from https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=math_solver_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PySpark Master Configuration (local[*] for all cores, or spark://host:7077 for cluster)
SPARK_MASTER=local[*]
SPARK_APP_NAME=MathProblemSolverETL

# Application Settings
APP_PORT=7860
APP_HOST=0.0.0.0
STORAGE_MODE=postgres  # Options: postgres, sqlite

# Analytical Thresholds for System Weakness Detection
THRESHOLD_ACCURACY_MIN=0.70
THRESHOLD_ERROR_RATE_MAX=0.30
THRESHOLD_COMPLEXITY_MAX=70.0
