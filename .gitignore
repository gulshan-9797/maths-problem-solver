# ==============================================================================
# Git Ignore Configuration for Mathematical Problem Solver Project
# ==============================================================================

# Environment & Secrets (NEVER commit secrets!)
.env
.env.local
*.env

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/

# PySpark / Apache Spark temporary logs and metastore
metastore_db/
derby.log
spark-warehouse/
.sparkStaging/
*.log

# Databases & Processed Big Data Lake
data/math_solver.db
data/processed/*.parquet
data/processed/problem_analytics.parquet/

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/
